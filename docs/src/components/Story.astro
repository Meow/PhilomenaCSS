---
import type { Story } from '../lib/stories';
interface Props { story: Story }
const { story } = Astro.props;
---
<article class="card" id={story.id}>
  <header class="card-header"><h2>{story.title}</h2></header>
  <p>{story.description}</p>
  {story.notes && (
    <ul class="docs-notes">
      {story.notes.map(note => <li set:html={note} />)}
    </ul>
  )}
  <div class="docs-preview" set:html={story.html} />
  <div class="docs-story-actions">
    <button type="button" class="button" data-copy-source><span class="button-content"><span class="button-text">Copy HTML</span></span></button>
  </div>
  <details>
    <summary>HTML source</summary>
    <pre class="docs-source"><code>{story.html}</code></pre>
  </details>
</article>
