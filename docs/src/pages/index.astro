---
import Base from '../layouts/Base.astro';
import Story from '../components/Story.astro';
import { stories } from '../lib/stories';
import { getTokenGroups } from '../lib/tokens';
import { icon } from '../lib/icons';

const tokenGroups = getTokenGroups();
const clipboardIcon = icon('fontawesome', 'clipboard');
const checkIcon = icon('fontawesome', 'check');
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<Base title="PhilomenaCSS">
  <header class="header docs-header">
    <span class="header-brand">
      <span class="header-brand-text">PhilomenaCSS</span>
    </span>
    <nav class="docs-nav">
      <a href={`${base}/#stories`}>Stories</a>
      <a href={`${base}/#playground`}>Playground</a>
      <a class="hidden-below-sm" href={`${base}/#tokens`}>
        Tokens
      </a>
      <a class="hidden-below-md" href="https://github.com/Meow/PhilomenaCSS">
        GitHub
      </a>
      <a class="hidden-below-md" href="https://www.npmjs.com/package/@philomena/philomena-css">
        npm
      </a>
    </nav>
  </header>

  <main class="docs-main">
    <article class="card">
      <header class="card-header">
        <h1>PhilomenaCSS</h1>
      </header>
      <p>
        The design of Philomena as an extensible, HTML/CSS-only framework, based on{' '}
        <a href="https://github.com/WentTheFox/HammerTimeCSS">HammerTimeCSS</a> and adapted for use in the{' '}
        <a href="https://github.com/philomena-dev/philomena">Philomena</a> project. Everything on this page is rendered
        with the published stylesheet; the controls below are docs-only JavaScript and are not part of the package.
      </p>
      <pre class="code-block"><code>npm install @philomena/philomena-css</code></pre>
    </article>

    <section class="card">
      <header class="card-header">
        <h2>Display options</h2>
      </header>
      <div class="docs-toolbar">
        <span class="docs-toolbar-label">Theme</span>
        <button type="button" class="button" data-theme-set="auto">
          <span class="button-content">
            <span class="button-text">Auto</span>
          </span>
        </button>
        <button type="button" class="button" data-theme-set="dark">
          <span class="button-content">
            <span class="button-text">Dark</span>
          </span>
        </button>
        <button type="button" class="button" data-theme-set="light">
          <span class="button-content">
            <span class="button-text">Light</span>
          </span>
        </button>
      </div>
    </section>

    <section id="stories" class="content">
      {stories.map(story => (
        <Story story={story} />
      ))}
    </section>

    <section id="playground" class="card">
      <header class="card-header">
        <h2>Base color playground</h2>
      </header>
      <p>
        The published stylesheet computes the chrome of each theme from <code class="code-span">$base-color-dark</code>{' '}
        and <code class="code-span">$base-color-light</code> at build time. This page uses a docs-only build that
        derives it from <code class="code-span">--base-color-dark</code> and{' '}
        <code class="code-span">--base-color-light</code> in the browser instead, so you can try colors live. The
        lightness of every derived color is fixed, so the contrast ratios hold for other hues too, give or take. The
        output shows the configuration to build with.
      </p>
      <div class="docs-toolbar">
        <label for="base-dark-input">Dark base</label>
        <input id="base-dark-input" class="input-field" type="color" value="#546c99" data-base-input="dark" />
        <label for="base-light-input">Light base</label>
        <input id="base-light-input" class="input-field" type="color" value="#62a7d9" data-base-input="light" />
        <button type="button" class="button" data-brand-reset>
          <span class="button-content">
            <span class="button-text">Reset</span>
          </span>
        </button>
        <button type="button" class="button" data-brand-copy>
          <span class="button-content">
            <span class="button-text">Copy CSS</span>
          </span>
        </button>
      </div>
      <pre class="code-block docs-source" data-brand-output></pre>
    </section>

    <section id="tokens" class="card">
      <header class="card-header">
        <h2>Token reference</h2>
      </header>
      <p>
        Read from the published stylesheet, so the colors are the computed defaults of each theme, the dark one first as
        it is the default (values and layering are the same in both). Use the copy button next to a property name to
        copy it.
      </p>
      {tokenGroups.map(group => (
        <details>
          <summary>
            {group.title} ({group.tokens.length})
          </summary>
          <div class="table-wrap responsive">
            <table class="table striped hover docs-token-table">
              <thead>
                <tr>
                  <th>Property</th>
                  <th>Dark</th>
                  <th>Light</th>
                </tr>
              </thead>
              <tbody>
                {group.tokens.map(token => (
                  <tr>
                    <td>
                      <div class="copyable-text">
                        <button
                          type="button"
                          class="button button-primary icon-only"
                          data-copy-text={token.name}
                          aria-label={`Copy ${token.name}`}
                          title="Copy to clipboard"
                        >
                          <span class="button-content">
                            <span class="button-icon docs-icon-copy" set:html={clipboardIcon} />
                            <span class="button-icon docs-icon-copied" set:html={checkIcon} />
                          </span>
                        </button>
                        <code class="code-span copyable-text-data">{token.name}</code>
                      </div>
                    </td>
                    <td>{token.value}</td>
                    <td>{token.light ?? ''}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </details>
      ))}
    </section>
    <footer class="card">
      <p>
        Icons shown in the demos are not part of PhilomenaCSS, which only provides slots for them.
        <a href="https://fontawesome.com">Font Awesome Free</a> solid icons are licensed
        <a href="https://creativecommons.org/licenses/by/4.0/">CC BY 4.0</a>, <a href="https://lucide.dev">Lucide</a>{' '}
        icons are licensed
        <a href="https://lucide.dev/license">ISC</a>.
      </p>
    </footer>
  </main>

  <script>
    const root = document.documentElement;
    const safe = <T,>(fn: () => T): T | undefined => {
      try {
        return fn();
      } catch {
        return undefined;
      }
    };

    const setTheme = (theme: string) => {
      if (theme === 'auto') root.removeAttribute('data-theme');
      else root.setAttribute('data-theme', theme);
      safe(() => localStorage.setItem('philomena-docs-theme', theme));
    };
    document
      .querySelectorAll<HTMLElement>('[data-theme-set]')
      .forEach(el => el.addEventListener('click', () => setTheme(el.dataset.themeSet!)));
    const stored = safe(() => localStorage.getItem('philomena-docs-theme'));
    if (stored) setTheme(stored);

    // A copy button keeps its result color (and label, if it has one) for a moment, then returns to its own look
    const copy = async (text: string, button: HTMLElement) => {
      if (button.classList.contains('pressed')) return;
      const ok = await navigator.clipboard.writeText(text).then(
        () => true,
        () => false,
      );
      const label = button.querySelector('.button-text');
      const original = label?.textContent;
      const own = button.classList.contains('button-primary') ? 'button-primary' : '';
      const result = ok ? 'button-success' : 'button-danger';
      if (label) label.textContent = ok ? 'Copied!' : 'Copy failed';
      if (own) button.classList.remove(own);
      button.classList.add(result, 'pressed');
      button.classList.toggle('docs-copied', ok);
      setTimeout(() => {
        if (label) label.textContent = original ?? '';
        button.classList.remove(result, 'pressed', 'docs-copied');
        if (own) button.classList.add(own);
      }, 1500);
    };
    document.querySelectorAll<HTMLElement>('[data-copy-source]').forEach(btn =>
      btn.addEventListener('click', () => {
        copy(btn.closest('article')?.querySelector('.docs-source')?.textContent ?? '', btn);
      }),
    );
    document
      .querySelectorAll<HTMLElement>('[data-copy-text]')
      .forEach(btn => btn.addEventListener('click', () => copy(btn.dataset.copyText!, btn)));

    // Tabs: the framework styles .selected, moving it is the page's job
    document.addEventListener('click', event => {
      const tab = (event.target as HTMLElement).closest<HTMLElement>('.tab[data-tab]');
      if (!tab) return;
      event.preventDefault();
      tab.parentElement!.querySelectorAll<HTMLElement>('.tab[data-tab]').forEach(other => {
        const selected = other === tab;
        other.classList.toggle('selected', selected);
        other.setAttribute('aria-selected', String(selected));
        document.getElementById(other.dataset.tab!)?.classList.toggle('selected', selected);
      });
      // Side tabs are a selector on narrow screens, which closes after a choice
      const toggle = tab.closest('.side-tabs')?.querySelector<HTMLInputElement>('.side-tabs-toggle');
      if (toggle) toggle.checked = false;
    });
    // Sliders with data-slider-fill keep --slider-fill at their value, for the filled track outside Firefox
    const fillSlider = (slider: HTMLInputElement) => {
      const min = Number(slider.min || 0);
      const max = Number(slider.max || 100);
      slider.style.setProperty('--slider-fill', `${((Number(slider.value) - min) / (max - min)) * 100}%`);
    };
    document.querySelectorAll<HTMLInputElement>('[data-slider-fill]').forEach(slider => {
      fillSlider(slider);
      slider.addEventListener('input', () => fillSlider(slider));
    });
    // Spoilers stay revealed once clicked
    document.addEventListener('click', event => {
      (event.target as HTMLElement).closest('.spoiler')?.classList.add('revealed');
    });

    document.querySelectorAll<HTMLElement>('[data-demo-toggle]').forEach(btn =>
      btn.addEventListener('click', () => {
        document.querySelector(btn.dataset.demoToggle!)?.classList.toggle('visible');
      }),
    );

    // --base-color-dark / --base-color-light playground
    const baseInputs = [...document.querySelectorAll<HTMLInputElement>('[data-base-input]')];
    const output = document.querySelector<HTMLElement>('[data-brand-output]')!;
    const defaultBase = new Map(baseInputs.map(input => [input.dataset.baseInput!, input.value]));
    const baseToken = (theme: string) => `--base-color-${theme}`;
    const changedBase = () => baseInputs.filter(input => input.value !== defaultBase.get(input.dataset.baseInput!));
    const apply = () => {
      baseInputs.forEach(input => {
        const theme = input.dataset.baseInput!;
        if (input.value !== defaultBase.get(theme)) root.style.setProperty(baseToken(theme), input.value);
        else root.style.removeProperty(baseToken(theme));
      });
      const parts: string[] = [];
      const changed = changedBase();
      if (changed.length) {
        parts.push(
          `/* in your overrides file, imported between config.css and framework.css */\n${changed.map(input => `$base-color-${input.dataset.baseInput}: ${input.value};`).join('\n')}`,
        );
      }
      output.textContent = parts.length ? parts.join('\n\n') : '/* defaults, nothing overridden */';
    };
    baseInputs.forEach(input => input.addEventListener('input', apply));
    document.querySelector('[data-brand-reset]')?.addEventListener('click', () => {
      baseInputs.forEach(input => {
        input.value = defaultBase.get(input.dataset.baseInput!)!;
      });
      apply();
    });
    document
      .querySelector<HTMLElement>('[data-brand-copy]')
      ?.addEventListener('click', e => copy(output.textContent ?? '', e.currentTarget as HTMLElement));
    apply();
  </script>
</Base>
