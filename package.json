{
  "name": "@philomena/philomena-css",
  "version": "0.1.0",
  "description": "HTML/CSS-only design framework based on HammerTimeCSS and adapted for Philomena, customizable through Sass variables",
  "keywords": [
    "css",
    "scss",
    "sass",
    "design-system",
    "css-variables",
    "dark-mode",
    "rtl",
    "no-js"
  ],
  "homepage": "https://github.com/Meow/PhilomenaCSS#readme",
  "bugs": {
    "url": "https://github.com/Meow/PhilomenaCSS/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Meow/PhilomenaCSS.git"
  },
  "license": "MIT",
  "author": "WentTheFox",
  "type": "module",
  "sass": "scss/_index.scss",
  "style": "dist/philomena.css",
  "exports": {
    ".": {
      "sass": "./scss/_index.scss",
      "style": "./dist/philomena.css",
      "default": "./dist/philomena.css"
    },
    "./design": {
      "sass": "./scss/design/_index.scss"
    },
    "./utils": {
      "sass": "./scss/utils/_index.scss"
    },
    "./components": {
      "sass": "./scss/components/_index.scss"
    },
    "./components/*": {
      "sass": "./scss/components/_*.scss"
    },
    "./scss/*": "./scss/*",
    "./dist/*": "./dist/*"
  },
  "files": [
    "scss",
    "dist"
  ],
  "scripts": {
    "build": "pnpm build:css && pnpm build:static",
    "build:css": "sass --load-path=node_modules --no-source-map scss/builds/css.scss dist/philomena.css && sass --load-path=node_modules --no-source-map --style=compressed scss/builds/css.scss dist/philomena.min.css",
    "build:static": "sass --load-path=node_modules --no-source-map scss/builds/static.scss dist/philomena.static.css && sass --load-path=node_modules --no-source-map --style=compressed scss/builds/static.scss dist/philomena.static.min.css",
    "commitlint": "commitlint --edit",
    "prepare": "husky"
  },
  "dependencies": {
    "the-new-css-reset": "^1.11.3"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.0",
    "@commitlint/config-conventional": "^21.2.0",
    "husky": "^9.1.7",
    "sass": "^1.105.1"
  },
  "engines": {
    "node": ">=24"
  },
  "publishConfig": {
    "access": "public"
  },
  "packageManager": "pnpm@12.16.1"
}
